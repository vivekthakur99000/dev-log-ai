# Dependency directories
# Ignores all node_modules in root, client, and server folders
node_modules/
*node_modules/
**/node_modules/

# Environment variables (Sensitive Data)
# Never push these to GitHub to protect API keys and DB URIs
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Production Build folders
# Exclude compiled output from React or other build tools
build/
dist/
out/
client/build/
client/dist/

# Debug and Logs
# Standard log files generated by npm or the OS
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log
logs/

# IDE and Editor specific files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo

# Testing and Coverage
coverage/
.nyc_output

# OS specific files
.DS_Store
Thumbs.db

# Optional: Databases (if running local MongoDB)
# Only use if you store local data in a folder within your project
data/
db/
